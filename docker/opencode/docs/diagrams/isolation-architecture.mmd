flowchart LR
    subgraph HOST["Host (your user, rootless Docker)"]
        CLAUDE["~/.claude<br/>.credentials.json, transcripts"]
        REPO["Host repo<br/>working tree, .git/hooks, config"]
        KDBX["KeePassXC .kdbx<br/>long-lived secrets"]
        SECRETS["stack/secrets/<br/>one file per secret<br/>mounted per service"]
    end

    subgraph AGENTNET["opencode-agent network (internal only)"]
        STAGED["staged ~/.claude<br/>skills, commands, hooks, agents<br/>credentials dropped"]
        CLONE["session clone<br/>branch opencode/id<br/>host .git/objects read-only"]
        AGENT["Agent container<br/>uid 60917, cap_drop ALL<br/>holds lease token + virtual key only"]
    end

    subgraph STACK["stack services"]
        BROKER["broker<br/>github-app.pem, keygen key"]
        LITELLM["LiteLLM<br/>provider keys, master key"]
        SQUID["Squid<br/>default-deny allowlist"]
        ADMIN["broker-admin<br/>127.0.0.1:8081, admin token<br/>driven by lease CLI on the host"]
    end

    INTERNET(("GitHub, model providers"))

    KDBX -->|"opencode-secrets.sh"| SECRETS
    SECRETS -->|"compose secrets"| BROKER
    CLAUDE -->|"allowlist copy"| STAGED
    REPO -->|"git clone --shared"| CLONE
    STAGED --> AGENT
    CLONE --> AGENT
    CLONE -.->|"run.sh review"| REPO
    AGENT -->|"GET /v1/token/service"| BROKER
    AGENT -->|"virtual key per lease"| LITELLM
    AGENT -->|"HTTPS_PROXY"| SQUID
    BROKER --> SQUID
    LITELLM --> SQUID
    SQUID --> INTERNET
    ADMIN -.->|"shared state"| BROKER

    classDef secret fill:#ffe3e3,stroke:#e03131,stroke-width:2px
    classDef agent fill:#d0ebff,stroke:#1971c2
    classDef files fill:#eebefa,stroke:#9c36b5
    classDef cli fill:#d3f9d8,stroke:#2f9e44
    classDef svc fill:#ffec99,stroke:#f08c00
    class KDBX,CLAUDE,SECRETS secret
    class AGENT agent
    class REPO,STAGED,CLONE files
    class BROKER,LITELLM,SQUID,ADMIN svc
