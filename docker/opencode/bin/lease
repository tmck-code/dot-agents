#!/usr/bin/env bash
# Host-side lease CLI for the OpenCode security stack.
#
#   lease approve --session ses_123 --repo owner/repo --ttl 8h
#   lease list
#   lease revoke lease_abcd1234
#   lease self                  # uses LEASE_TOKEN/BROKER_URL (agent-side)
#   lease grant lse_abcd1234 excalidraw --ttl 30m --keepassxc excalidraw/api-key
#   lease ungrant lse_abcd1234 excalidraw
#   lease token github          # print a token for debugging
#
# Admin calls go to the host-only listener (127.0.0.1:8081 by default) and
# need LEASE_ADMIN_TOKEN or the token file below. The lease token is written to
# ~/.local/state/opencode/lease-token with 0600 permissions.
set -euo pipefail

ADMIN_URL="${LEASE_ADMIN_URL:-http://127.0.0.1:8081}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADMIN_TOKEN_FILE="${LEASE_ADMIN_TOKEN_FILE:-$SCRIPT_DIR/../stack/secrets/broker-admin.token}"
SERVICES_DIR="${LEASE_SERVICES_DIR:-$SCRIPT_DIR/../stack/secrets/services}"
AUDIT_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/opencode/audit.jsonl"
STATE_TOKEN_FILE="${LEASE_TOKEN_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/opencode/lease-token}"
BROKER_URL="${BROKER_URL:-http://127.0.0.1:8081}"

die() { echo "lease: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  lease approve --session ID --service github|litellm|all [options]
  lease create ...            # alias for approve
  lease list
  lease revoke LEASE_ID
  lease self
  lease grant LEASE_ID SERVICE [--ttl DURATION] [--file PATH | --keepassxc ENTRY]
  lease ungrant LEASE_ID SERVICE
  lease token SERVICE         # github, litellm or a granted service

approve options:
  --session ID        Session identifier recorded on the lease (required)
  --service NAME      github, litellm or all (default: all)
  --repo OWNER/REPO   Repository scope; repeatable (required for github)
  --action NAME       Permission, e.g. contents:read; repeatable or comma-separated
  --ttl DURATION      8h, 30m, 3600 (default: broker default, 8h)
  --model NAME        LiteLLM model alias; repeatable or comma-separated
  --budget USD        Per-lease LiteLLM budget
  --no-write          Do not write the lease token to the state file

Environment:
  LEASE_ADMIN_URL, LEASE_ADMIN_TOKEN, LEASE_ADMIN_TOKEN_FILE,
  LEASE_TOKEN_FILE, BROKER_URL, LEASE_TOKEN
EOF
}

LOG_COMPONENT="lease-cli"

# log_event EVENT OUTCOME [LEASE_ID] [REPO] [DETAIL_JSON]
# Appends one schema line to the audit log. Secret-bearing detail keys are dropped.
log_event() {
  local event="$1" outcome="$2" lease_id="${3:-}" repo="${4:-}" detail="${5:-}"
  [[ -n "$detail" ]] || detail='{}'
  local ts line
  ts="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)"
  line="$(jq -nc \
    --arg ts "$ts" --arg component "$LOG_COMPONENT" --arg event "$event" \
    --arg lease_id "$lease_id" --arg repo "$repo" --arg outcome "$outcome" \
    --argjson detail "$detail" \
    '{ts: $ts, component: $component, event: $event,
      lease_id: (if $lease_id == "" then null else $lease_id end),
      repo: (if $repo == "" then null else $repo end),
      outcome: $outcome,
      detail: ($detail | del(.token, .lease_token, .litellm_key, .private_key, .values))}')" || return 0
  local dir
  dir="$(dirname "$AUDIT_LOG")"
  (
    umask 077
    mkdir -p "$dir"
    printf '%s\n' "$line" >> "$AUDIT_LOG"
  ) 2>/dev/null || true
}

http_detail() {
  jq -nc --arg http "$HTTP_CODE" '{http: $http}'
}

# admin_request METHOD PATH [curl args...]
# Sets RESPONSE and HTTP_CODE. Returns 0 only for a 2xx status.
admin_request() {
  local method="$1" path="$2"
  shift 2
  local out tok
  tok="$(admin_token)" || exit 1
  out="$(mktemp)"
  HTTP_CODE="$(curl -sS --max-time 15 -o "$out" -w '%{http_code}' \
    -X "$method" "$ADMIN_URL$path" \
    -H "X-Admin-Token: $tok" "$@")" || HTTP_CODE="000"
  RESPONSE="$(cat "$out")"
  rm -f "$out"
  [[ "$HTTP_CODE" =~ ^2[0-9][0-9]$ ]]
}

admin_token() {
  if [[ -n "${LEASE_ADMIN_TOKEN:-}" ]]; then
    printf '%s' "$LEASE_ADMIN_TOKEN"
    return
  fi
  if [[ -f "$ADMIN_TOKEN_FILE" ]]; then
    tr -d '\r\n' < "$ADMIN_TOKEN_FILE"
    return
  fi
  die "no admin token: set LEASE_ADMIN_TOKEN or create $ADMIN_TOKEN_FILE"
}

parse_ttl() {
  local value="$1"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    printf '%s' "$value"
  elif [[ "$value" =~ ^([0-9]+)([smhd])$ ]]; then
    local n="${BASH_REMATCH[1]}"
    case "${BASH_REMATCH[2]}" in
      s) printf '%s' "$n" ;;
      m) printf '%s' "$((n * 60))" ;;
      h) printf '%s' "$((n * 3600))" ;;
      d) printf '%s' "$((n * 86400))" ;;
    esac
  else
    die "invalid --ttl: $value (use 30m, 8h or seconds)"
  fi
}

split_items() {
  local raw="$1"
  local IFS=','
  local item
  for item in $raw; do
    item="$(printf '%s' "$item" | xargs)"
    [[ -n "$item" ]] && printf '%s\n' "$item"
  done
}

json_array() {
  if (($# == 0)); then
    printf '[]'
    return
  fi
  printf '%s\n' "$@" | jq -R . | jq -s .
}

cmd_approve() {
  local session="" service="all" ttl="" budget="" write_token=1
  local -a repos=() actions=() models=()
  while (($#)); do
    case "$1" in
      --session) session="${2:?--session needs a value}"; shift 2 ;;
      --service) service="${2:?--service needs a value}"; shift 2 ;;
      --repo) repos+=("${2:?--repo needs a value}"); shift 2 ;;
      --action) mapfile -t _items < <(split_items "${2:?--action needs a value}"); actions+=("${_items[@]}"); shift 2 ;;
      --actions) mapfile -t _items < <(split_items "${2:?--actions needs a value}"); actions+=("${_items[@]}"); shift 2 ;;
      --ttl) ttl="${2:?--ttl needs a value}"; shift 2 ;;
      --model) mapfile -t _items < <(split_items "${2:?--model needs a value}"); models+=("${_items[@]}"); shift 2 ;;
      --models) mapfile -t _items < <(split_items "${2:?--models needs a value}"); models+=("${_items[@]}"); shift 2 ;;
      --budget) budget="${2:?--budget needs a value}"; shift 2 ;;
      --no-write) write_token=0; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown approve option: $1" ;;
    esac
  done
  [[ -n "$session" ]] || die "approve needs --session"

  ((${#actions[@]})) || actions=("contents:read")
  local ttl_seconds=""
  [[ -n "$ttl" ]] && ttl_seconds="$(parse_ttl "$ttl")"

  local body
  body="$(jq -n \
    --arg session "$session" \
    --arg service "$service" \
    --argjson resources "$(json_array "${repos[@]}")" \
    --argjson actions "$(json_array "${actions[@]}")" \
    --argjson models "$(json_array "${models[@]}")" \
    --arg ttl "${ttl_seconds}" \
    --arg budget "$budget" \
    '{
      session: $session,
      service: $service,
      resources: $resources,
      actions: $actions,
      models: $models
    }
    + (if $ttl == "" then {} else {ttl_seconds: ($ttl | tonumber)} end)
    + (if $budget == "" then {} else {budget_usd: ($budget | tonumber)} end)')"

  local response repo_arg="" first_repo="${repos[0]:-}"
  [[ -n "$first_repo" ]] && repo_arg="$first_repo"
  if ! admin_request POST "/v1/leases" -H "Content-Type: application/json" -d "$body"; then
    log_event lease.approve error "" "$repo_arg" "$(jq -nc --arg http "$HTTP_CODE" --arg service "$service" '{http: $http, service: $service}')"
    die "could not create lease (http $HTTP_CODE; is the stack running?)"
  fi
  response="$RESPONSE"
  log_event lease.approve ok "$(jq -r '.lease_id // empty' <<<"$response")" "$repo_arg" \
    "$(jq -nc --arg http "$HTTP_CODE" --arg service "$service" --arg session "$session" '{http: $http, service: $service, session: $session}')"

  local token
  token="$(jq -r '.lease_token // empty' <<<"$response")"
  if ((write_token)) && [[ -n "$token" ]]; then
    mkdir -p "$(dirname "$STATE_TOKEN_FILE")"
    umask 077
    printf '%s\n' "$token" > "$STATE_TOKEN_FILE"
    chmod 600 "$STATE_TOKEN_FILE"
    echo "lease: wrote lease token to $STATE_TOKEN_FILE" >&2
  fi
  jq '{lease_id, session, service, resources, actions, models, budget_usd, expires_at, lease_token}' <<<"$response"
}

cmd_list() {
  curl -fsS --max-time 15 \
    -H "X-Admin-Token: $(admin_token)" \
    "$ADMIN_URL/v1/leases" | jq .
}

cmd_revoke() {
  local lease_id="${1:-}"
  [[ -n "$lease_id" ]] || die "revoke needs a lease id"
  if ! admin_request POST "/v1/leases/$lease_id/revoke"; then
    log_event lease.revoke error "$lease_id" "" "$(http_detail)"
    die "revoke failed (http $HTTP_CODE)"
  fi
  log_event lease.revoke ok "$lease_id" "" "$(http_detail)"
  jq . <<<"$RESPONSE"
}

# Read NAME=value lines from a file into a temp file of cleaned lines.
read_env_file() {
  local src="$1" dest="$2" name value count=0
  while IFS='=' read -r name value || [[ -n "$name" ]]; do
    name="${name%$'\r'}"
    value="${value%$'\r'}"
    [[ -z "$name" || "$name" == \#* ]] && continue
    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name in $src"
    printf '%s=%s\n' "$name" "$value" >> "$dest"
    count=$((count + 1))
  done < "$src"
  ((count)) || die "no NAME=value lines in $src"
}

# Fetch an entry password with keepassxc-cli; the database password goes on stdin.
read_keepassxc() {
  local entry="$1" dest="$2" db="${KEEPASSXC_DB:-$HOME/.secrets.kdbx}" password secret
  command -v keepassxc-cli >/dev/null 2>&1 || die "keepassxc-cli is not installed"
  [[ -f "$db" ]] || die "KeePassXC database not found: $db"
  password="${KEEPASSXC_PASSWORD:-}"
  if [[ -z "$password" ]]; then
    read -rsp "KeePassXC password for $db: " password < /dev/tty >&2 || die "no KeePassXC password"
    echo >&2
  fi
  secret="$(printf '%s\n' "$password" | keepassxc-cli show -q -a password "$db" "$entry")" \
    || die "keepassxc-cli could not read entry $entry"
  [[ -n "$secret" ]] || die "KeePassXC entry $entry has an empty password"
  printf 'TOKEN=%s\n' "$secret" >> "$dest"
}

cmd_grant() {
  local lease_id="" service="" ttl="" file="" entry=""
  while (($#)); do
    case "$1" in
      --ttl) ttl="${2:?--ttl needs a value}"; shift 2 ;;
      --file) file="${2:?--file needs a value}"; shift 2 ;;
      --keepassxc) entry="${2:?--keepassxc needs a value}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown grant option: $1" ;;
      *)
        if [[ -z "$lease_id" ]]; then lease_id="$1"
        elif [[ -z "$service" ]]; then service="$1"
        else die "unexpected argument: $1"
        fi
        shift ;;
    esac
  done
  [[ -n "$lease_id" && -n "$service" ]] || die "grant needs a lease id and a service"
  [[ "$service" =~ ^[a-z][a-z0-9-]{1,31}$ ]] || die "invalid service name: $service"
  case "$service" in
    github|litellm|all) die "service $service is reserved and cannot be granted" ;;
  esac
  [[ -z "$file" || -z "$entry" ]] || die "use only one of --file and --keepassxc"
  if [[ -z "$entry" && -z "$file" ]]; then
    file="$SERVICES_DIR/$service.env"
  fi
  if [[ -z "$entry" && ! -f "$file" ]]; then
    die "missing service file: $file (expected NAME=value lines)"
  fi
  local ttl_seconds=900
  [[ -n "$ttl" ]] && ttl_seconds="$(parse_ttl "$ttl")"

  local old_umask
  old_umask="$(umask)"
  umask 077
  local pairs body_file
  pairs="$(mktemp)"
  body_file="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$pairs' '$body_file'" EXIT
  umask "$old_umask"

  if [[ -n "$entry" ]]; then
    read_keepassxc "$entry" "$pairs"
  else
    read_env_file "$file" "$pairs"
  fi
  jq -n --arg service "$service" --argjson ttl "$ttl_seconds" --rawfile pairs "$pairs" \
    '{service: $service, ttl_seconds: $ttl,
      values: ($pairs | split("\n") | map(select(length > 0))
        | map(index("=") as $i | {key: .[:$i], value: .[$i + 1:]}) | from_entries)}' \
    > "$body_file"

  local detail
  detail="$(jq -nc --arg service "$service" --argjson ttl "$ttl_seconds" '{service: $service, ttl_seconds: $ttl}')"
  if ! admin_request POST "/v1/leases/$lease_id/grants" \
      -H "Content-Type: application/json" --data-binary "@$body_file"; then
    log_event lease.grant error "$lease_id" "" "$(jq -c --arg http "$HTTP_CODE" '. + {http: $http}' <<<"$detail")"
    rm -f "$pairs" "$body_file"
    die "grant failed (http $HTTP_CODE)"
  fi
  rm -f "$pairs" "$body_file"
  log_event lease.grant ok "$lease_id" "" "$(jq -c --arg http "$HTTP_CODE" '. + {http: $http}' <<<"$detail")"
  jq 'del(.values, .secret_json)' <<<"$RESPONSE"
}

cmd_ungrant() {
  local lease_id="${1:-}" service="${2:-}"
  [[ -n "$lease_id" && -n "$service" ]] || die "ungrant needs a lease id and a service"
  local detail
  detail="$(jq -nc --arg service "$service" '{service: $service}')"
  if ! admin_request DELETE "/v1/leases/$lease_id/grants/$service"; then
    log_event lease.ungrant error "$lease_id" "" "$(jq -c --arg http "$HTTP_CODE" '. + {http: $http}' <<<"$detail")"
    die "ungrant failed (http $HTTP_CODE)"
  fi
  log_event lease.ungrant ok "$lease_id" "" "$(jq -c --arg http "$HTTP_CODE" '. + {http: $http}' <<<"$detail")"
  jq 'del(.values, .secret_json)' <<<"$RESPONSE"
}

cmd_self() {
  : "${LEASE_TOKEN:?LEASE_TOKEN is not set}"
  curl -fsS --max-time 15 \
    -H "Authorization: Bearer $LEASE_TOKEN" \
    "$BROKER_URL/v1/leases/self" | jq .
}

cmd_token() {
  local service="${1:-}"
  [[ "$service" =~ ^[a-z][a-z0-9-]{1,31}$ ]] || die "token needs a service name (github, litellm or a granted service)"
  :"${LEASE_TOKEN:?LEASE_TOKEN is not set}"
  curl -fsS --max-time 15 \
    -H "Authorization: Bearer $LEASE_TOKEN" \
    "$BROKER_URL/v1/token/$service" | jq .
}

command="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command" in
  approve|create) cmd_approve "$@" ;;
  list|ls) cmd_list "$@" ;;
  revoke) cmd_revoke "$@" ;;
  self) cmd_self "$@" ;;
  token) cmd_token "$@" ;;
  grant) cmd_grant "$@" ;;
  ungrant) cmd_ungrant "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $command (try --help)" ;;
esac
