#!/usr/bin/env bash
# Git credential helper backed by the lease broker.
#
# Install (the image does this) as `git-credential-lease`, then:
#   git config --global credential.https://github.com.helper '!git-credential-lease'
#
# It returns a short-lived GitHub App installation token at call time. Without
# BROKER_URL/LEASE_TOKEN it exits non-zero rather than falling back to a host
# credential.
set -euo pipefail

: "${BROKER_URL:?BROKER_URL is not set}"
: "${LEASE_TOKEN:?LEASE_TOKEN is not set}"

action="${1:-get}"
case "$action" in
  get)
    token="$(curl -fsS --max-time 10 \
      -H "Authorization: Bearer ${LEASE_TOKEN}" \
      "${BROKER_URL%/}/v1/token/github" | jq -r '.token // empty')"
    if [[ -z "$token" ]]; then
      echo "git-credential-lease: broker returned no token" >&2
      exit 1
    fi
    printf 'username=x-access-token\npassword=%s\n\n' "$token"
    ;;
  store|erase)
    # Nothing to store: the token is fetched per operation.
    ;;
  *)
    echo "git-credential-lease: unsupported action: $action" >&2
    exit 1
    ;;
esac
