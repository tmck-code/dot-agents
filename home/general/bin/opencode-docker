#!/usr/bin/env bash
# Run the OpenCode dev container against the repo you are standing in.
#
#   opencode-docker                 # OpenCode TUI in this repo
#   opencode-docker --stack         # start the safe stack + lease, then run
#   opencode-docker --shell         # bash in the same container setup
#   opencode-docker run "explain"   # any non-TUI OpenCode command
#   opencode-docker --unsafe        # legacy trust model, for trusted debugging
#   opencode-docker --status        # show the safe-stack containers
#   opencode-docker --down          # stop the safe stack (add --volumes to wipe state)
#
# The git root of $PWD (or $PWD itself outside git) is mounted at the same
# absolute path inside the container. Override the mount with REPO_ROOT, or
# point at a different launcher with OPENCODE_DOCKER_RUN_SH.
set -euo pipefail

# Resolve this script through the ~/bin symlink to the dot-agents checkout.
if command -v realpath >/dev/null 2>&1; then
  self="$(realpath "${BASH_SOURCE[0]}")"
else
  self="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
fi
here="$(cd "$(dirname "$self")" && pwd -P)"
repo_root="${REPO_ROOT:-$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")}"
repo_root="$(cd "$repo_root" && pwd -P)"

run_sh="${OPENCODE_DOCKER_RUN_SH:-$here/../../../docker/opencode/run.sh}"
if [[ ! -x "$run_sh" ]]; then
  echo "error: OpenCode docker launcher not found or not executable: $run_sh" >&2
  echo "       set OPENCODE_DOCKER_RUN_SH to override" >&2
  exit 1
fi
docker_dir="$(cd "$(dirname "$run_sh")" && pwd -P)"

if ! command -v docker >/dev/null 2>&1; then
  echo "error: docker not found on PATH" >&2
  exit 1
fi

usage() {
  cat <<'EOF'
Usage: opencode-docker [wrapper options] [opencode arguments]

Wrapper options:
  --stack          start the safe stack + lease, then launch
  --status         show the safe-stack containers
  --down           stop the safe stack (pass --volumes to remove named volumes)
  --unsafe         legacy trust model, for trusted debugging
  -h, --help       show this help and run.sh options

Everything else is passed through to run.sh/opencode, e.g. --shell or
`run "summarise this repo"`.
EOF
}

compose=(docker compose -f "$docker_dir/stack/docker-compose.yml" --profile llama --profile tools)

# --stack starts the documented safe-mode stack (internal network, Squid,
# broker, LiteLLM, local qwen model) and approves a lease before launching.
args=("$@")
want_stack=0
want_unsafe=0
want_help=0
want_down=0
want_status=0
for arg in "${args[@]}"; do
  case "$arg" in
    --stack) want_stack=1 ;;
    --unsafe) want_unsafe=1 ;;
    --down) want_down=1 ;;
    --status) want_status=1 ;;
    -h|--help) want_help=1 ;;
  esac
done

pass_args=()
for arg in "${args[@]}"; do
  case "$arg" in
    --stack|--down|--status) ;;
    *) pass_args+=("$arg") ;;
  esac
done

if (( want_down && want_status )); then
  echo "error: --down and --status are mutually exclusive" >&2
  exit 2
fi

if (( want_help )); then
  usage
  echo
  exec "$run_sh" --help
elif (( want_down )); then
  "${compose[@]}" down --remove-orphans "${pass_args[@]}"
  # `run.sh` starts the agent with `docker run` (no compose service), so a
  # running agent can keep the network alive after compose down. Remove any
  # leftover container attached to the dedicated network, then the network.
  leftovers="$(docker ps -q --filter network=opencode-agent 2>/dev/null || true)"
  if [[ -n "$leftovers" ]]; then
    echo "Stopping leftover agent containers..." >&2
    # shellcheck disable=SC2086
    docker rm -f $leftovers >/dev/null
  fi
  docker network rm opencode-agent >/dev/null 2>&1 || true
  exit 0
elif (( want_status )); then
  exec "${compose[@]}" ps "${pass_args[@]}"
elif (( want_stack )); then
  echo "Starting the safe OpenCode stack (this can take a minute)..." >&2
  make -C "$docker_dir" llama-up
elif (( ! want_unsafe )) && ! docker network inspect opencode-agent >/dev/null 2>&1; then
  cat >&2 <<EOF
error: the safe-mode stack is not running.

Start it once (safe mode, local qwen model + lease):
  opencode-docker --stack

Or run a one-off with host credentials:
  opencode-docker --unsafe

Manual setup:
  make -C "$docker_dir" llama-up
EOF
  exit 1
fi

printf 'OpenCode container: %s\n' "$repo_root" >&2
export REPO_ROOT="$repo_root"
exec "$run_sh" "${pass_args[@]}"
