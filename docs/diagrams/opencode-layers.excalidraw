    {
      "type": "text",
      "id": "ev-2-text",
      "x": 574,
      "y": 292,
      "width": 812,
      "height": 56,
      "text": "{ \"policies\": [\n  { \"action\": \"tool.use\", \"resource\": \"shell:git push *\", \"effect\": \"deny\" },\n  { \"action\": \"provider.use\", \"resource\": \"openai\", \"effect\": \"deny\" } ] }",
