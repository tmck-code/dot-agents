   "roundness": null,
   "text": "Intercepts every Bash call that\ncontains an npm-family token.\n\nallow   no npm / not Bash\ndeny    yarn, pnpm, compound\n        commands, npm run/test\nmutate  install, add, rm, ci:\n        run in Docker, copy\n        package*.json back,\n        then DENY host npm",
   "originalText": "Intercepts every Bash call that\ncontains an npm-family token.\n\nallow   no npm / not Bash\ndeny    yarn, pnpm, compound\n        commands, npm run/test\nmutate  install, add, rm, ci:\n        run in Docker, copy\n        package*.json back,\n        then DENY host npm",
   "fontSize": 13,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
