      "updated": 1,
      "roundness": null,
      "text": "Throwaway node container with\nNO bind mounts. docker cp the\npackage.json in, run npm, cp\nthe result back. node_modules\nis never created on the host.",
      "originalText": "Throwaway node container with\nNO bind mounts. docker cp the\npackage.json in, run npm, cp\nthe result back. node_modules\nis never created on the host.",
