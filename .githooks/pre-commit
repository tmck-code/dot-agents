#!/usr/bin/env bash
# Repository guards:
#   1. Fail if home/{linux,osx}/.claude/settings.json have drifted apart, ignoring
#      keys that are deliberately per-machine or OS-specific.
#   2. Fail if a file that belongs in home/general/ reappears under home/linux/
#      or home/osx/ (one shared copy, no per-OS forks).
# Bypass with: SKIP_SETTINGS_DRIFT=1 git commit ...
set -euo pipefail

[[ "${SKIP_SETTINGS_DRIFT:-}" == "1" ]] && exit 0

repo_root=$(git rev-parse --show-toplevel)

# --- 0. obsolete files and secrets --------------------------------------------------
if [[ -e "$repo_root/docker/opencode/Dockerfile.new" ]]; then
  echo "pre-commit: docker/opencode/Dockerfile.new is obsolete; edit Dockerfile instead." >&2
  exit 1
fi
if [[ -x "$repo_root/scripts/secret-scan.sh" ]]; then
  "$repo_root/scripts/secret-scan.sh"
fi

linux="$repo_root/home/linux/.claude/settings.json"
osx="$repo_root/home/osx/.claude/settings.json"

# --- 2. shared files must not be duplicated per OS ---------------------------------
shared=(
  "home/linux/.claude/CLAUDE.md"
  "home/osx/.claude/CLAUDE.md"
  "home/linux/.claude/delegate-routing.json"
  "home/osx/.claude/delegate-routing.json"
  "home/linux/.claude/skill-routing.json"
  "home/osx/.claude/skill-routing.json"
  "home/linux/.claude/skill-nudge-system.md"
  "home/osx/.claude/skill-nudge-system.md"
  "home/linux/.claude/scripts/gate.sh"
  "home/osx/.claude/scripts/gate.sh"
  "home/linux/.claude/scripts/yas.sh"
  "home/osx/.claude/scripts/yas.sh"
  "home/linux/.claude/hooks/subagent-git-tree-guard.py"
  "home/osx/.claude/hooks/subagent-git-tree-guard.py"
)
bad=()
for path in "${shared[@]}"; do
  [[ -e "$repo_root/$path" ]] && bad+=("$path")
done
for dir in home/linux/.claude/agents home/osx/.claude/agents; do
  [[ -d "$repo_root/$dir" ]] && bad+=("$dir/")
done
if (( ${#bad[@]} )); then
  echo "pre-commit: shared config must live only under home/general/:" >&2
  printf '  %s\n' "${bad[@]}" >&2
  exit 1
fi

# --- 1. settings drift --------------------------------------------------------------
[[ -f "$linux" && -f "$osx" ]] || exit 0
command -v jq >/dev/null || { echo "pre-commit: jq not found, skipping settings drift check" >&2; exit 0; }

# Deliberately per-machine: model, remote-control/push toggles.
# OS-specific: notification, stop and stop-failure hooks; statusline; the YAS
# prompt hook (resolved per machine by scripts/yas.sh). Disabled plugin entries
# are noise, ignore.
normalise() {
  jq --sort-keys '
    del(.model, .remoteControlAtStartup, .agentPushNotifEnabled,
        .statusLine, .hooks.Notification, .hooks.Stop, .hooks.StopFailure)
    | .hooks.UserPromptSubmit |= map(select(all(.hooks[]; .command | contains("yas.sh") | not)))
    | .enabledPlugins |= with_entries(select(.value))
  ' "$1"
}

if ! diff -u <(normalise "$linux") <(normalise "$osx"); then
  echo >&2
  echo "pre-commit: home/linux and home/osx .claude/settings.json have drifted (see diff above)." >&2
  echo "Reconcile them, or bypass with SKIP_SETTINGS_DRIFT=1 git commit ..." >&2
  exit 1
fi
